# RAG Knowledge Assistant environment
# Copy this file to .env before first boot.

# Required
APP_ENV=dev
APP_VERSION=0.9.0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/minirag

# Required when using the bundled Postgres service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=minirag

# Optional host port overrides.
API_HOST_PORT=8010
POSTGRES_HOST_PORT=5440

# API settings.
APP_HOST=0.0.0.0
APP_PORT=8010
# Comma-separated origins. Set explicitly for hosted production frontend(s).
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Enables DELETE /api/demo-data when set; send it as X-Admin-Key.
ADMIN_API_KEY=
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_CHARS=2000000

# Embeddings settings.
# EMBEDDINGS_PROVIDER: hash | sentence_transformers | openai
EMBEDDINGS_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Answer generation settings.
# LLM_PROVIDER: local | gemini | openai_compatible
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini

# Gemini provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible provider.
# Use this for OpenAI, OpenRouter, Groq, DeepSeek, Qwen-compatible endpoints, or Kimi/Moonshot.
OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=gpt-4o-mini

# Chunking settings.
CHUNK_SIZE=220
CHUNK_OVERLAP=40
DEFAULT_TOP_K=5

# Retrieval settings.
# RETRIEVAL_MODE: vector | fts | hybrid
RETRIEVAL_MODE=hybrid
VECTOR_WEIGHT=1.0
FTS_WEIGHT=0.2

# Worker settings.
WORKER_POLL_INTERVAL=1.0
WORKER_IDLE_SLEEP=1.0
INGESTION_JOB_STALE_SECONDS=300
