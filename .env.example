# Mini RAGFlow environment
# Copy this file to .env before first boot.

# Required
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/minirag

# Required when using the bundled Postgres service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=minirag

# Optional host port overrides.
API_HOST_PORT=8010
POSTGRES_HOST_PORT=5440

# Optional API settings.
APP_HOST=0.0.0.0
APP_PORT=8010

# Optional embeddings and LLM settings.
# EMBEDDINGS_PROVIDER: hash | sentence_transformers | openai
EMBEDDINGS_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional chunking settings.
CHUNK_SIZE=220
CHUNK_OVERLAP=40
DEFAULT_TOP_K=5

# Optional retrieval settings.
# RETRIEVAL_MODE: vector | fts | hybrid
RETRIEVAL_MODE=hybrid
VECTOR_WEIGHT=1.0
FTS_WEIGHT=0.2

# Optional worker settings.
WORKER_POLL_INTERVAL=1.0
WORKER_IDLE_SLEEP=1.0
